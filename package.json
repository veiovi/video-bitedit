{
  "name": "videdit",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply videdit --local",
    "db:migrate:remote": "wrangler d1 migrations apply videdit --remote",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "videdit": "node bin/videdit.mjs",
    "render-worker": "node bin/videdit.mjs worker"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@remotion/bundler": "^4.0.537",
    "@remotion/player": "^4.0.537",
    "@remotion/renderer": "^4.0.537",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true
  },
  "bin": {
    "videdit": "bin/videdit.mjs"
  },
  "description": "Open-source video editor for people and AI agents: local timeline editor, Cloudflare sharing, Remotion rendering, one-click publishing",
  "license": "MIT",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veiovi/video-bitedit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "video-editor",
    "remotion",
    "cloudflare",
    "ffmpeg",
    "ai-agents"
  ],
  "files": [
    "bin",
    "src",
    "migrations",
    "public",
    "index.html",
    "vite.config.ts",
    "tsconfig*.json",
    "wrangler.example.jsonc",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/veiovi/video-bitedit#readme",
  "bugs": {
    "url": "https://github.com/veiovi/video-bitedit/issues"
  }
}
